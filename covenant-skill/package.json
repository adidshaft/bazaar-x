{
  "name": "@bazaar-x/covenant-skill",
  "version": "0.1.0",
  "description": "Typed policy, treasury, tax, and governance primitives for Bazaar X world-economy systems.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./skill": {
      "types": "./dist/skill.d.ts",
      "import": "./dist/skill.js",
      "default": "./dist/skill.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p ./tsconfig.build.json && node ./scripts/prepare-dist.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "pnpm run build && node --test ./test/**/*.test.mjs",
    "example": "pnpm run build && node ./examples/basic-usage.mjs",
    "pack:dry-run": "pnpm run build && npm pack --dry-run",
    "smoke:install": "pnpm run build && node ./scripts/smoke-install.mjs",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "governance",
    "policy",
    "treasury",
    "tax",
    "game-economy"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
